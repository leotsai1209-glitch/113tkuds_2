class Solution {
    public ListNode removeNthFromEnd(ListNode head, int n) {
        ListNode dummy = new ListNode(0);
        dummy.next = head;
        ListNode fast = dummy;
        ListNode slow = dummy;
        
        // 快指針先走 n + 1 步，讓 slow 停在要刪的前一個
        for (int i = 0; i <= n; i++) {
            fast = fast.next;
        }
        
        while (fast != null) {
            fast = fast.next;
            slow = slow.next;
        }

        // 移除 slow 後面那個 node
        slow.next = slow.next.next;
        
        return dummy.next;
    }
}