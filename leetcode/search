class Solution {
    public int search(int[] nums, int target) {
        int left = 0, right = nums.length - 1;

        while (left <= right) {
            int mid = (left + right) / 2;

            if (nums[mid] == target) {
                return mid;
            }

            // 左半段是有序的
            if (nums[left] <= nums[mid]) {
                if (nums[left] <= target && target < nums[mid]) {
                    right = mid - 1; // target 在左半區段
                } else {
                    left = mid + 1; // target 不在左半區段
                }
            }
            // 右半段是有序的
            else {
                if (nums[mid] < target && target <= nums[right]) {
                    left = mid + 1; // target 在右半區段
                } else {
                    right = mid - 1; // target 不在右半區段
                }
            }
        }

        return -1; // 找不到
    }
}